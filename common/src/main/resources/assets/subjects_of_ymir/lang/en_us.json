  "ability.text.subjects_of_ymir.root.title": "Power of the Titans",
  "ability.text.subjects_of_ymir.root.description": "Under certain conditions, you are capable of transforming into your Titan form. After spending enough time and practice with your Titan, extra abilities may become available to you.",
  "ability.text.subjects_of_ymir.bite.title": "Bite        ",
  "ability.text.subjects_of_ymir.bite.description": "Bite your hand, intentionally drawing blood, to allow for a Titan transformation.",
  "ability.text.subjects_of_ymir.conceal.title": "Conceal      ",
  "ability.text.subjects_of_ymir.conceal.description": "Intentionally inhibit your Titan abilities, removing any visual giveaways of your power.",
  "ability.text.subjects_of_ymir.steam_healing_overdrive.title": "Steam Overdrive",
  "ability.text.subjects_of_ymir.steam_healing_overdrive.description": "Kick your steam healing into high gear, rapidly closing any wounds.",
  "ability.text.subjects_of_ymir.block.title": "Block     ",
  "ability.text.subjects_of_ymir.block.description": "Shield yourself with your arms to reduce incoming damage.",
  "ability.text.subjects_of_ymir.failsafe.title": "Failsafe    ",
  "ability.text.subjects_of_ymir.failsafe.description": "After shifting into a Titan enough times, it can become enough of a habit that you subconsciously transform to save yourself from death.",

  "ability.text.subjects_of_ymir.attack.root.title": "Attack Titan",
  "ability.text.subjects_of_ymir.attack.root.description": "Your Titan form is strong, durable, and motivated to keep moving forward.\n\n§7HP: 20\nATK: 7\nSPD: 3\nDEF: 8",
  "ability.text.subjects_of_ymir.attack.crystal_eject.title": "Crystal Ejection",
  "ability.text.subjects_of_ymir.attack.crystal_eject.description": "Apply hardening to every inch of your skin, forming a tough, solid crystal before ejecting from Titan form §7(held keybind)§r.",
  "ability.text.subjects_of_ymir.attack.infinite_crystal.title": "Crystal Domain",
  "ability.text.subjects_of_ymir.attack.infinite_crystal.description": "With practice and extra Titan serum, you can continue to grow your hardened crystal forever up until ejection.",
  "ability.text.subjects_of_ymir.attack.hardening_knuckles.title": "Hardened Knuckles",
  "ability.text.subjects_of_ymir.attack.hardening_knuckles.description": "You can harden the skin of just your fingers, lethally augmenting your punches at the cost of attack speed.",
  "ability.text.subjects_of_ymir.attack.hardening_hands.title": "Hardening Hands",
  "ability.text.subjects_of_ymir.attack.hardening_hands.description": "You can harden the rest of your hands, dealing even more damage.",
  "ability.text.subjects_of_ymir.attack.berserk.title": "Berserk",
  "ability.text.subjects_of_ymir.attack.berserk.description": "Gain a violent, fiery second wind upon death that lasts for up to sixty seconds.",

  "ability.text.subjects_of_ymir.armored.root.title": "Armored Titan",
  "ability.text.subjects_of_ymir.armored.root.description": "Your Titan form is a lumbering, defensive powerhouse with striking offensive capability. Be careful, because even though your armor can take a beating, it is not indestructible. \n\n§7HP: 20\nATK: 8\nSPD: 2\nDEF: 30",
  "ability.text.subjects_of_ymir.armored.block.title": "Block       ",
  "ability.text.subjects_of_ymir.armored.block.description": "Shield yourself with your arms to reduce incoming damage. While moving at high speeds, blocking will cleave a path of destruction in front of you.",
  "ability.text.subjects_of_ymir.armored.shed.title": "Shed       ",
  "ability.text.subjects_of_ymir.armored.shed.description": "Intentionally shed your armor, increasing your Titan's movement speed at the cost of your attack damage and defense.",
  "ability.text.subjects_of_ymir.armored.hardening.title": "Hardening",
  "ability.text.subjects_of_ymir.armored.hardening.description": "With enough practice, you can harden the skin around your Titan's knuckles to really pack your punches.",
  "ability.text.subjects_of_ymir.armored.climbing.title": "Climbing",
  "ability.text.subjects_of_ymir.armored.climbing.description": "You can claw into walls to hold on and jump off of them."
}