{
  "base": "#NAMESPACE:textures/models/titan/#TITAN/#VAR/eyes.png",
  "variables": {
    "NAMESPACE": {
      "type": "subjects_of_ymir:titan_namespace"
    },
    "TITAN": {
      "type": "subjects_of_ymir:titan_id"
    },
    "VAR": {
      "type": "subjects_of_ymir:titan_variant"
    },
    "PROGRESS": {
      "type": "subjects_of_ymir:titan_progress",
      "subtract": 30,
      "min": 0,
      "max": 20
    },
    "COLOR": {
      "type": "subjects_of_ymir:titan_eye_color"
    },
    "DECAY": {
      "type": "subjects_of_ymir:titan_decay",
      "subtract": 500,
      "min": 0,
      "max": 255
    }
  },
  "transformers": [
    {
      "type": "palladium:alpha_mask",
      "mask": "subjects_of_ymir:textures/models/alpha_masks/shift/#PROGRESS.png"
    },
    {
      "type": "palladium:color",
      "color": "##COLOR",
      "ignore_blank": true
    },
    {
      "type": "palladium:alpha_mask",
      "mask": "subjects_of_ymir:textures/models/alpha_masks/corpse/decay/128/#DECAY.png"
    }
  ],
  "output": "#NAMESPACE:textures/models/titans/#TITAN/#VAR/eyes_#PROGRESS_#COLOR_#DECAY"
}